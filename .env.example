# Set these as Replit Secrets; never commit real values
DEMO_PASSWORD=
PORT=3000
HOST=0.0.0.0
# Set to 1 on HTTPS deployment. Do not use for localhost HTTP.
COOKIE_SECURE=0

# Hosted mode: require a distinct password for each enabled demo username.
# Store a JSON mapping as a secret, never in this file.
# NODE_ENV=production
# DEMO_PASSWORDS_JSON=

# Optional demo-only shared passwords by role, stored only in Replit Secrets.
# Set BOTH, with distinct passphrases of at least 12 characters each.
# These override account-map passwords for coordinators and volunteers only.
# Administrator credentials continue to use DEMO_PASSWORDS_JSON.
DEMO_COORDINATOR_PASSWORD=
DEMO_VOLUNTEER_PASSWORD=
