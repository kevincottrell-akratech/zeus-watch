{
  "name": "zeus-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic-data cat colony census and care coordination demo",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm ci --include=dev && npm --prefix client ci --include=dev",
    "build": "node scripts/build-colony-map-data.mjs && npm --prefix client run build",
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "sharp": "^0.35.5"
  }
}
