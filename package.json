{
  "name": "zeus-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic-data cat colony census and care coordination demo",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
